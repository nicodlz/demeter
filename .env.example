# UrsaLock server holding the encrypted vault.
# Set this in production; the built-in fallback is only a development default.
VITE_VAULT_SERVER_URL=https://vault.example.com

# Server-side proxy for IBKR (and optionally Zerion) that hides provider tokens.
# Required for IBKR in production: the Flex Web Service has no CORS headers.
VITE_PROXY_URL=https://proxy.example.com

# Optional shared secret expected by the proxy.
VITE_PROXY_KEY=
